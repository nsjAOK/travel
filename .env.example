# Copy to .env.local and fill in what you have. Everything is optional:
# with nothing set, the app runs on clearly labelled sample data.

# Reads your trip description (https://platform.claude.com). Without it, a simpler built-in reader is used.
ANTHROPIC_API_KEY=

# Live flight and hotel prices (https://duffel.com - a free test token starts with duffel_test_).
DUFFEL_ACCESS_TOKEN=

# Set to 1 only on your own computer to let the app open membership sites
# in a browser window that keeps your sign-ins (stored in ./.browser-profile).
MEMBERSHIP_BROWSER=
